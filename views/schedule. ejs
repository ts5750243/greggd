<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Schedule - People & Schedule</title>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700&family=Rajdhani:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    body {
      margin: 0;
      font-family: 'Rajdhani', sans-serif;
      background: #050505;
      color: white;
    }
    .topbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 14px 20px;
      background: #0d0d0d;
      border-bottom: 1px solid #222;
    }
    .topbar a {
      color: #00ff88;
      text-decoration: none;
      margin-left: 18px;
      font-weight: 600;
    }
    .container {
      width: 95%;
      max-width: 1000px;
      margin: 20px auto;
    }
    h1 {
      font-family: 'Orbitron', sans-serif;
      color: #00ff88;
      font-size: 1.6rem;
    }
    .card {
      background: #0d0d0d;
      border: 1px solid #222;
      padding: 18px;
      border-radius: 10px;
      margin-bottom: 18px;
    }
    input {
      padding: 9px;
      background: #111;
      border: 1px solid #333;
      color: white;
      border-radius: 6px;
    }
    button {
      background: #00ff88;
      color: black;
      padding: 9px 14px;
      border: none;
      border-radius: 6px;
      font-weight: bold;
      cursor: pointer;
    }
    table {
      width: 100%;
      border-collapse: collapse;
    }
    th, td {
      padding: 10px 8px;
      border-bottom: 1px solid #222;
      text-align: left;
      vertical-align: middle;
    }
    th {
      color: #00ff88;
    }
    .time-input {
      width: 110px;
    }
    .notes-input {
      width: 140px;
    }
  </style>
</head>
<body>

  <div class="topbar">
    <div>
      <strong style="color:#00ff88;">People & Schedule</strong>
    </div>
    <div>
      <a href="/people">People</a>
      <a href="/schedule">Schedule</a>
      <a href="/logout">Logout</a>
    </div>
  </div>

  <div class="container">
    <h1>Daily Schedule</h1>

    <!-- DATE PICKER -->
    <div class="card">
      <form method="GET" action="/schedule" style="display:flex; gap:12px; align-items:center;">
        <label>Date:</label>
        <input type="date" name="date" value="<%= date %>" required>
        <button type="submit">Load</button>
      </form>
    </div>

    <!-- SCHEDULE TABLE -->
    <div class="card">
      <table>
        <thead>
          <tr>
            <th>Name</th>
            <th>Start</th>
            <th>End</th>
            <th>Lunch Start</th>
            <th>Lunch End</th>
            <th>Notes</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% if (people && people.length > 0) { %>
            <% people.forEach(person => { 
              const s = scheduleMap[person.id] || {};
            %>
              <tr>
                <form method="POST" action="/schedule/save">
                  <input type="hidden" name="person_id" value="<%= person.id %>">
                  <input type="hidden" name="date" value="<%= date %>">

                  <td><%= person.name %></td>
                  <td>
                    <input class="time-input" type="time" name="start_time" value="<%= s.start_time ? s.start_time.substring(0,5) : '' %>">
                  </td>
                  <td>
                    <input class="time-input" type="time" name="end_time" value="<%= s.end_time ? s.end_time.substring(0,5) : '' %>">
                  </td>
                  <td>
                    <input class="time
