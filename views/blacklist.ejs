    height: 70px;
    border-radius: 50%;
    border: 2px solid #00ff88;
    box-shadow: 0 0 12px #00ff88;
    object-fit: cover;
  }

  h1 {
    font-family: 'Orbitron', sans-serif;
    color: #00ff88;
    font-size: 2.2rem;
    margin-top: 10px;
  }

  .status {
    display: inline-block;
