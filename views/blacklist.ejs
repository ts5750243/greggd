<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Blacklist</title>

  <style>
    body {
      margin: 0;
      font-family: Arial;
      background: #0b0f19;
      color: #fff;
    }

    .topbar {
      background: #111827;
      padding: 15px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .container {
      padding: 15px;
    }

    input {
      padding: 10px;
      border: none;
      border-radius: 6px;
      background: #1f2937;
      color: white;
      outline: none;
    }

    button {
      padding: 10px 12px;
      border: none;
      border-radius: 6px;
      background: #3b82f6;
      color: white;
      cursor: pointer;
    }

    button:hover {
      background: #2563eb;
    }

    table {
      width: 100%;
      margin-top: 15px;
      border-collapse: collapse;
    }

    th, td {
      padding: 10px;
      border-bottom: 1px solid #1f2937;
      text-align: left;
    }

    tr:hover {
      background: #111827;
    }

    .badge {
      background: red;
      padding: 4px 8px;
      border-radius: 6px;
      font-size: 12px;
    }

    .flex {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .modal {
      display: none;
      position: fixed;
      top: 20%;
      left: 50%;
      transform: translateX(-50%);
      background: #111827;
      padding: 20px;
      border-radius: 10px;
      width: 300px;
    }

    .modal input {
      width: 100%;
      margin-bottom: 10px;
    }

    @media (max-width: 600px) {
      table {
        font-size: 12px;
      }
    }
  </style>
</head>

<body>

<div class="topbar">
  <div><b>BLACKLIST</b></div>

  <div>
    <% if (user) { %>
      <%= user.username %>
      | <a href="/logout" style="color:#f87171;">Logout</a>
    <% } else { %>
      <a href="/login" style="color:#60a5fa;">Login</a>
    <% } %>
  </div>
</div>

<div class="container">

  <!-- SEARCH -->
  <form method="GET" class="flex">
    <input name="search" placeholder="Search..." value="<%= search || '' %>">
    <button>Search</button>
  </form>

  <!-- ADD BUTTON -->
  <% if (canEdit) { %>
    <button style="margin-top:10px;" onclick="document.getElementById('modal').style.display='block'">
      + Add Entry
    </button>
  <% } %>

  <!-- TABLE -->
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Steam ID</th>
        <th>Reason</th>
        <th>Status</th>
        <% if (canEdit) { %>
          <th>Action</th>
        <% } %>
      </tr>
    </thead>

    <tbody>
      <% (data || []).forEach(entry => { %>
        <tr>
          <td><%= entry.name %></td>
          <td><%= entry.steam_id %></td>
          <td><%= entry.reason %></td>
          <td><span class="badge">BANNED</span></td>

          <% if (canEdit) { %>
            <td>
              <form method="POST" action="/delete">
                <input type="hidden" name="id" value="<%= entry.id %>">
                <button>Delete</button>
              </form>
            </td>
          <% } %>
        </tr>
      <% }) %>
    </tbody>
  </table>

</div>

<!-- ADD MODAL -->
<div id="modal" class="modal">
  <form method="POST" action="/add">
    <input name="name" placeholder="Name" required>
    <input name="steam_id" placeholder="Steam ID">
    <input name="reason" placeholder="Reason" required>

    <button type="submit">Add</button>
    <button type="button" onclick="document.getElementById('modal').style.display='none'">
      Close
    </button>
  </form>
</div>

</body>
</html>
