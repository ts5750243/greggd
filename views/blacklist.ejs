<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Greggs Blacklist</title>

  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #0b0b0b;
      color: white;
    }

    .topbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 15px 20px;
      background: #111;
      border-bottom: 1px solid #222;
    }

    .topbar h1 {
      margin: 0;
      font-size: 20px;
    }

    .logo {
      width: 40px;
      height: 40px;
      border-radius: 8px;
    }

    input, button {
      padding: 8px;
      margin: 4px;
      border-radius: 6px;
      border: none;
    }

    input {
      background: #1a1a1a;
      color: white;
      border: 1px solid #333;
    }

    button {
      background: #2b6cff;
      color: white;
      cursor: pointer;
    }

    button:hover {
      opacity: 0.9;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 15px;
    }

    th, td {
      padding: 10px;
      border-bottom: 1px solid #222;
      text-align: left;
    }

    th {
      background: #111;
    }

    .danger {
      background: red;
    }

    .container {
      padding: 20px;
    }

    /* MODAL */
    #overlay {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0,0,0,0.7);
      z-index: 999;
    }

    #editBox {
      display: none;
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      background: #1a1a1a;
      padding: 20px;
      border-radius: 10px;
      z-index: 1000;
      width: 320px;
    }

    #editBox input {
      width: 100%;
      margin: 5px 0;
    }
  </style>
</head>

<body>

<!-- TOP BAR -->
<div class="topbar">
  <div style="display:flex; align-items:center; gap:10px;">
    <img src="https://i.imgur.com/lhNa6cM.png" class="logo">
    <h1>Greggs Blacklist</h1>
  </div>

  <div>
    <% if (user) { %>
      <span>Logged in as <%= user.username %></span>
      <a href="/logout"><button>Logout</button></a>
    <% } else { %>
      <a href="/login"><button>Login</button></a>
    <% } %>
  </div>
</div>

<div class="container">

  <!-- SEARCH -->
  <form method="GET">
    <input name="search" placeholder="Search blacklist..." value="<%= search %>">
    <button type="submit">Search</button>
  </form>

  <!-- ADD -->
  <% if (canEdit) { %>
    <h3>Add Entry</h3>
    <form method="POST" action="/add">
      <input name="name" placeholder="Name" required>
      <input name="steam_id" placeholder="Steam ID">
      <input name="reason" placeholder="Reason">
      <input name="discord_id" placeholder="Discord ID">
      <button type="submit">Add</button>
    </form>
  <% } %>

  <!-- TABLE -->
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Steam ID</th>
        <th>Reason</th>
        <th>Discord ID</th>
        <th>Actions</th>
      </tr>
    </thead>

    <tbody>
      <% data.forEach(entry => { %>
        <tr>
          <td><%= entry.name %></td>
          <td><%= entry.steam_id || "-" %></td>
          <td><%= entry.reason || "-" %></td>
          <td><%= entry.discord_id || "-" %></td>

          <td>
            <% if (canEdit) { %>

              <button onclick="openEdit(
                '<%= entry.id %>',
                '<%= entry.name %>',
                '<%= entry.steam_id %>',
                '<%= entry.reason %>',
                '<%= entry.discord_id %>'
              )">Edit</button>

              <form method="POST" action="/delete" style="display:inline;">
                <input type="hidden" name="id" value="<%= entry.id %>">
                <button class="danger">Remove</button>
              </form>

            <% } else { %>
              -
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>

</div>

<!-- OVERLAY -->
<div id="overlay"></div>

<!-- EDIT MODAL -->
<div id="editBox">
  <form method="POST" action="/edit">
    <input type="hidden" name="id" id="eid">

    <input name="name" id="ename" placeholder="Name">
    <input name="steam_id" id="esteam" placeholder="Steam ID">
    <input name="reason" id="ereason" placeholder="Reason">
    <input name="discord_id" id="ediscord" placeholder="Discord ID">

    <button type="submit">Save</button>
    <button type="button" onclick="closeEdit()">Cancel</button>
  </form>
</div>

<script>
function openEdit(id, name, steam, reason, discord) {
  document.getElementById("eid").value = id;
  document.getElementById("ename").value = name;
  document.getElementById("esteam").value = steam;
  document.getElementById("ereason").value = reason;
  document.getElementById("ediscord").value = discord;

  document.getElementById("editBox").style.display = "block";
  document.getElementById("overlay").style.display = "block";
}

function closeEdit() {
  document.getElementById("editBox").style.display = "none";
  document.getElementById("overlay").style.display = "none";
}

document.getElementById("overlay").onclick = closeEdit;
</script>

</body>
</html>
