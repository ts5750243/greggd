<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Blacklist</title>

  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #0f1115;
      color: #fff;
    }

    .topbar {
      background: #161a22;
      padding: 15px 25px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid #2a2f3a;
    }

    .title {
      font-size: 20px;
      font-weight: bold;
      letter-spacing: 1px;
    }

    .container {
      padding: 25px;
    }

    .btn {
      padding: 10px 15px;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      font-weight: bold;
    }

    .btn-add {
      background: #3b82f6;
      color: white;
    }

    .btn-delete {
      background: #ef4444;
      color: white;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 20px;
      background: #161a22;
      border-radius: 10px;
      overflow: hidden;
    }

    th, td {
      padding: 14px;
      text-align: left;
      border-bottom: 1px solid #2a2f3a;
    }

    th {
      background: #1c2230;
      color: #9ca3af;
      font-size: 13px;
      text-transform: uppercase;
    }

    tr:hover {
      background: #1a1f2a;
    }

    .badge {
      padding: 5px 10px;
      border-radius: 5px;
      font-size: 12px;
    }

    .bad {
      background: #ef4444;
    }

    .good {
      background: #22c55e;
    }

    .header-right {
      display: flex;
      gap: 10px;
      align-items: center;
    }

    a {
      color: #60a5fa;
      text-decoration: none;
    }

    .modal {
      display: none;
      position: fixed;
      top: 0; left: 0;
      width: 100%; height: 100%;
      background: rgba(0,0,0,0.7);
      justify-content: center;
      align-items: center;
    }

    .modal-content {
      background: #161a22;
      padding: 20px;
      border-radius: 10px;
      width: 300px;
    }

    input {
      width: 100%;
      padding: 8px;
      margin: 5px 0;
      background: #0f1115;
      border: 1px solid #2a2f3a;
      color: white;
      border-radius: 5px;
    }
  </style>
</head>

<body>

<div class="topbar">
  <div class="title">BLACKLIST</div>

  <div class="header-right">
    <% if (user) { %>
      <span><%= user.username %></span>
      <a href="/logout">Logout</a>
    <% } else { %>
      <a href="/login">Login</a>
    <% } %>

    <% if (canEdit) { %>
      <button class="btn btn-add" onclick="openModal()">+ Add</button>
    <% } %>
  </div>
</div>

<div class="container">

<table>
  <tr>
    <th>Name</th>
    <th>Steam ID</th>
    <th>Reason</th>
    <th>Status</th>
    <% if (canEdit) { %>
      <th>Action</th>
    <% } %>
  </tr>

  <% active.forEach(entry => { %>
    <tr>
      <td><%= entry.name %></td>
      <td><%= entry.steam_id %></td>
      <td><%= entry.reason %></td>
      <td><span class="badge bad">BLACKLISTED</span></td>

      <% if (canEdit) { %>
        <td>
          <form method="POST" action="/api/blacklist/delete">
            <input type="hidden" name="id" value="<%= entry.id %>">
            <button class="btn btn-delete">Delete</button>
          </form>
        </td>
      <% } %>
    </tr>
  <% }) %>

</table>

</div>

<!-- MODAL -->
<div class="modal" id="modal">
  <div class="modal-content">
    <h3>Add Entry</h3>

    <form method="POST" action="/api/blacklist/add">
      <input name="name" placeholder="Name" required />
      <input name="steam_id" placeholder="Steam ID" />
      <input name="reason" placeholder="Reason" required />
      <button class="btn btn-add" type="submit">Add</button>
    </form>

    <br>
    <button class="btn" onclick="closeModal()">Close</button>
  </div>
</div>

<script>
function openModal() {
  document.getElementById("modal").style.display = "flex";
}

function closeModal() {
  document.getElementById("modal").style.display = "none";
}
</script>

</body>
</html>
