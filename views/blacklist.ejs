<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Greggs Blacklist</title>

  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700;800&family=Rajdhani:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style>
    body {
      margin: 0;
      font-family: 'Rajdhani', sans-serif;
      background: #050505;
      color: white;
    }

    .hero {
      text-align: center;
      padding: 40px 20px;
    }

    .logo {
      width: 90px;
      border-radius: 50%;
      border: 2px solid #00ff88;
    }

    h1 {
      color: #00ff88;
      font-family: 'Orbitron', sans-serif;
    }

    .container {
      width: 95%;
      max-width: 1200px;
      margin: auto;
    }

    .card {
      background: #0d0d0d;
      padding: 20px;
      border-radius: 10px;
      margin-bottom: 20px;
      border: 1px solid #222;
    }

    input {
      width: 100%;
      padding: 10px;
      margin: 5px 0;
      background: #111;
      border: 1px solid #333;
      color: white;
      border-radius: 6px;
    }

    .btn {
      background: #00ff88;
      color: black;
      padding: 10px 15px;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      font-weight: bold;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    th, td {
      padding: 10px;
      border-bottom: 1px solid #222;
      text-align: left;
    }

    th {
      color: #00ff88;
    }

    .steam-id { color: #f5b942; }
    .discord-id { color: #7289da; }

    .topbar {
      display: flex;
      justify-content: space-between;
      padding: 15px;
      background: #0d0d0d;
      border-bottom: 1px solid #222;
    }
  </style>
</head>

<body>

<!-- HERO -->
<div class="hero">
  <img src="https://i.imgur.com/lhNa6cM.png" class="logo">
  <h1>Greggs Blacklist</h1>
</div>

<!-- TOPBAR -->
<div class="topbar">
  <div>
    <% if (user) { %>
      Logged in as <%= user.username %>
    <% } else { %>
      Not logged in
    <% } %>
  </div>

  <div>
    <% if (user) { %>
      <a href="/logout"><button class="btn">Logout</button></a>
    <% } else { %>
      <a href="/login"><button class="btn">Login</button></a>
    <% } %>
  </div>
</div>

<div class="container">

  <!-- SEARCH -->
  <div class="card">
    <form method="GET" action="/">
      <input name="search" placeholder="Search blacklist..." value="<%= search || '' %>">
      <button class="btn">Search</button>
    </form>
  </div>

  <!-- ADD FORM -->
  <% if (canEdit) { %>
  <div class="card">
    <h3>Add Blacklist Entry</h3>

    <form method="POST" action="/add">
      <input name="name" placeholder="Name" required>
      <input name="steam_id" placeholder="Steam ID">
      <input name="reason" placeholder="Reason">
      <input name="discord_id" placeholder="Discord ID">

      <button class="btn">Add</button>
    </form>
  </div>
  <% } %>

  <!-- TABLE -->
  <div class="card">
    <table>
      <tr>
        <th>Name</th>
        <th>Steam ID</th>
        <th>Reason</th>
        <th>Discord ID</th>
        <% if (canEdit) { %><th>Actions</th><% } %>
      </tr>

      <% if (data && data.length > 0) { %>
        <% data.forEach(item => { %>
          <tr>
            <td><%= item.name %></td>
            <td class="steam-id"><%= item.steam_id %></td>
            <td><%= item.reason %></td>
            <td class="discord-id"><%= item.discord_id %></td>

            <% if (canEdit) { %>
              <td>
                <form method="POST" action="/delete">
                  <input type="hidden" name="id" value="<%= item.id %>">
                  <button class="btn">Remove</button>
                </form>
              </td>
            <% } %>
          </tr>
        <% }) %>
      <% } else { %>
        <tr>
          <td colspan="5">No entries found</td>
        </tr>
      <% } %>

    </table>
  </div>

</div>

</body>
</html>
