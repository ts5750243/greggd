<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - People & Schedule</title>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700&family=Rajdhani:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    body {
      margin: 0;
      font-family: 'Rajdhani', sans-serif;
      background: #050505;
      color: white;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
    }
    .login-box {
      background: #0d0d0d;
      border: 1px solid #222;
      padding: 30px;
      border-radius: 12px;
      width: 100%;
      max-width: 360px;
      text-align: center;
    }
    h1 {
      font-family: 'Orbitron', sans-serif;
      color: #00ff88;
      margin-bottom: 20px;
      font-size: 1.5rem;
    }
    input {
      width: 100%;
      padding: 12px;
      margin: 8px 0;
      background: #111;
      border: 1px solid #333;
      color: white;
      border-radius: 6px;
      box-sizing: border-box;
    }
    button {
      width: 100%;
      background: #00ff88;
      color: black;
      padding: 12px;
      border: none;
      border-radius: 6px;
      font-weight: bold;
      cursor: pointer;
      margin-top: 10px;
      font-size: 1rem;
    }
    .error {
      color: #ff5555;
      margin-bottom: 10px;
    }
  </style>
</head>
<body>
  <div class="login-box">
    <h1>People & Schedule</h1>

    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>

    <form method="POST" action="/login">
      <input type="text" name="username" placeholder="Username" required>
      <input type="password" name="password" placeholder="Password" required>
      <button type="submit">Login</button>
    </form>
  </div>
</body>
</html>
