<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>People - People & Schedule</title>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700&family=Rajdhani:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    body {
      margin: 0;
      font-family: 'Rajdhani', sans-serif;
      background: #050505;
      color: white;
    }
    .topbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 14px 20px;
      background: #0d0d0d;
      border-bottom: 1px solid #222;
    }
    .topbar a {
      color: #00ff88;
      text-decoration: none;
      margin-left: 18px;
      font-weight: 600;
    }
    .container {
      width: 95%;
      max-width: 900px;
      margin: 20px auto;
    }
    h1 {
      font-family: 'Orbitron', sans-serif;
      color: #00ff88;
      font-size: 1.6rem;
    }
    .card {
      background: #0d0d0d;
      border: 1px solid #222;
      padding: 18px;
      border-radius: 10px;
      margin-bottom: 18px;
    }
    input, textarea {
      width: 100%;
      padding: 10px;
      margin: 6px 0;
      background: #111;
      border: 1px solid #333;
      color: white;
      border-radius: 6px;
      box-sizing: border-box;
    }
    button, .btn {
      background: #00ff88;
      color: black;
      padding: 9px 14px;
      border: none;
      border-radius: 6px;
      font-weight: bold;
      cursor: pointer;
      margin-top: 6px;
    }
    table {
      width: 100%;
      border-collapse: collapse;
    }
    th, td {
      padding: 12px 10px;
      border-bottom: 1px solid #222;
      text-align: left;
    }
    th {
      color: #00ff88;
    }
    .actions form {
      display: inline;
    }
    .actions button {
      margin-right: 6px;
    }
  </style>
</head>
<body>

  <div class="topbar">
    <div>
      <strong style="color:#00ff88;">People & Schedule</strong>
    </div>
    <div>
      <a href="/people">People</a>
      <a href="/schedule">Schedule</a>
      <a href="/logout">Logout</a>
    </div>
  </div>

  <div class="container">
    <h1>People</h1>

    <!-- ADD PERSON -->
    <div class="card">
      <h3 style="margin-top:0; color:#00ff88;">Add Person</h3>
      <form method="POST" action="/people/add">
        <input type="text" name="name" placeholder="Full name" required>
        <input type="text" name="preferred_name" placeholder="Preferred name (optional)">
        <textarea name="notes" placeholder="Notes (optional)" rows="2"></textarea>
        <button type="submit">Add Person</button>
      </form>
    </div>

    <!-- PEOPLE LIST -->
    <div class="card">
      <table>
        <thead>
          <tr>
            <th>Name</th>
            <th>Preferred</th>
            <th>Notes</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (people && people.length > 0) { %>
            <% people.forEach(person => { %>
              <tr>
                <td><%= person.name %></td>
                <td><%= person.preferred_name || "—" %></td>
                <td><%= person.notes || "—" %></td>
                <td class="actions">
                  <form method="POST" action="/people/deactivate" onsubmit="return confirm('Remove this person?')">
                    <input type="hidden" name="id" value="<%= person.id %>">
                    <button type="submit">Remove</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="4">No people added yet.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

</body>
</html>
